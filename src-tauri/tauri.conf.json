{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "gasipro",
  "version": "../package.json",
  "identifier": "com.gasipro",
  "build": {
    "frontendDist": "../dist/gasipro/browser",
    "devUrl": "http://localhost:4200",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "GasiPro",
        "width": 960,
        "height": 720,
        "resizable": true,
        "fullscreen": true,
        "maximized": true,
        "alwaysOnTop": true,
        "minWidth": 960,
        "minHeight": 720,
        "focus": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUxRjgxNjQ1ODVCMzhCNzYKUldSMmk3T0ZSUmI0VVJha3RBV1o4cEJvNWVUdHFERy9yRlVHSVUrclB0UHNlaG1mdm9CKzV5NlkK",
      "endpoints": [
        "https://github.com/GasiPro/cashier-management/releases/latest/download/latest.json"
      ]
    }
  }
} 